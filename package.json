{
  "name": "dsh-session-artifacts",
  "version": "0.1.0",
  "description": "Sidebar tab listing every file produced by a conversation — deliverables and touched files — with path, size and a reversible trash.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "install.mjs",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RDYRD/dsh-session-artifacts.git"
  },
  "homepage": "https://github.com/RDYRD/dsh-session-artifacts#readme",
  "bugs": {
    "url": "https://github.com/RDYRD/dsh-session-artifacts/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "dsh-better-sidebar"
      ],
      "platform": "web"
    },
    "manifestVersion": 1
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "dsh-better-sidebar": ">=0.28.0"
  },
  "scripts": {
    "test": "node test/test-smoke.mjs && node test/probe-client.mjs && node test/probe-host.mjs",
    "test:smoke": "node test/test-smoke.mjs",
    "test:client": "node test/probe-client.mjs",
    "test:host": "node test/probe-host.mjs",
    "test:sessions": "node test/probe-sessions.mjs",
    "install:local": "node install.mjs",
    "uninstall:local": "node install.mjs --remove"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sidebar",
    "artifacts",
    "deliverables",
    "session"
  ],
  "license": "MIT",
  "private": true
}
