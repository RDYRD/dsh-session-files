{
  "name": "dsh-session-files",
  "version": "0.2.1",
  "description": "A sidebar tab listing every file a conversation produced — preview them in place, or jump back to the turn that made them.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "install.mjs",
    "README.md",
    "LICENSE"
  ],
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RDYRD/dsh-session-files.git"
  },
  "homepage": "https://github.com/RDYRD/dsh-session-files#readme",
  "bugs": {
    "url": "https://github.com/RDYRD/dsh-session-files/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "dsh-better-sidebar"
      ],
      "platform": "web"
    },
    "manifestVersion": 1
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "dsh-better-sidebar": ">=0.28.0"
  },
  "scripts": {
    "test": "node test/test-smoke.mjs && node test/probe-client.mjs && node test/probe-host.mjs",
    "test:smoke": "node test/test-smoke.mjs",
    "test:client": "node test/probe-client.mjs",
    "test:host": "node test/probe-host.mjs",
    "test:sessions": "node test/probe-sessions.mjs",
    "install:local": "node install.mjs",
    "uninstall:local": "node install.mjs --remove"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sidebar",
    "artifacts",
    "deliverables",
    "session"
  ],
  "license": "MIT"
}
